{
	"name": "@romanbsd/mnemon-openai",
	"version": "0.3.7",
	"description": "OpenAI Agents SDK helpers for Mnemon: propose/recall durable memory with organization and per-user scopes.",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/romanbsd/mnemon-eve.git",
		"directory": "packages/openai"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./jev": {
			"types": "./dist/jev.d.ts",
			"import": "./dist/jev.js"
		}
	},
	"files": [
		"dist",
		"src",
		"README.md",
		"LICENSE",
		"NOTICE"
	],
	"sideEffects": false,
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"check-types": "tsc --noEmit",
		"prepack": "npm run build"
	},
	"dependencies": {
		"@romanbsd/mnemon-core": "^0.3.7",
		"@romanbsd/mnemon-eve": "^0.3.7"
	},
	"peerDependencies": {
		"@openai/agents": "^0.22.0",
		"eve": "^1.0.0",
		"zod": "^4.0.0"
	},
	"peerDependenciesMeta": {
		"eve": {
			"optional": true
		}
	},
	"engines": {
		"node": ">=24"
	},
	"keywords": [
		"openai-agents",
		"mnemon",
		"memory",
		"agent",
		"multi-tenant",
		"rls"
	],
	"devDependencies": {
		"@openai/agents": "^0.22.0",
		"eve": "^1.0.0",
		"zod": "^4.6.5"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org"
	}
}

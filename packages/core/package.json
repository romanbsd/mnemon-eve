{
	"name": "@romanbsd/mnemon-core",
	"version": "0.3.0",
	"description": "TypeScript Mnemon memory engine on PostgreSQL + pgvector with tenant row-level security.",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/romanbsd/mnemon-eve.git",
		"directory": "packages/core"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"src",
		"README.md",
		"LICENSE",
		"NOTICE"
	],
	"sideEffects": false,
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"check-types": "tsc --noEmit",
		"prepack": "npm run build"
	},
	"dependencies": {
		"pg": "^8.23.0",
		"pgvector": "^0.3.0"
	},
	"devDependencies": {
		"@types/pg": "^8.23.1",
		"typescript": "^6.0.3"
	},
	"engines": {
		"node": ">=24"
	},
	"keywords": [
		"mnemon",
		"memory",
		"agent",
		"postgres",
		"pgvector",
		"rls"
	],
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org"
	}
}

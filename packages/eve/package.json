{
	"name": "@romanbsd/mnemon-eve",
	"version": "0.2.0",
	"description": "Eve memory provider backed by Mnemon: organization and per-user memory with PostgreSQL RLS and a Jev write gate.",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/romanbsd/mnemon-eve.git",
		"directory": "packages/eve"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"src",
		"README.md",
		"LICENSE",
		"NOTICE"
	],
	"sideEffects": false,
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"check-types": "tsc --noEmit",
		"prepack": "npm run build"
	},
	"dependencies": {
		"@ai-sdk/typesafe-ai": "^3.0.12",
		"@romanbsd/mnemon-core": "^0.2.0"
	},
	"peerDependencies": {
		"eve": ">=0.67.0 <0.68.0",
		"zod": "^4.0.0"
	},
	"engines": {
		"node": ">=24"
	},
	"keywords": [
		"eve",
		"eve-memory",
		"mnemon",
		"memory",
		"agent",
		"multi-tenant",
		"rls"
	],
	"devDependencies": {
		"ai": "^7.0.126",
		"eve": "^0.67.2",
		"zod": "^4.6.5"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org"
	}
}
